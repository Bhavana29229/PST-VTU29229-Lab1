class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> ans = new ArrayList<>();

        int[] a = new int[26];
        int[] b = new int[26];

        for (int i = 0; i < p.length(); i++) {
            a[p.charAt(i) - 'a']++;
            b[s.charAt(i) - 'a']++;
        }

        for (int i = p.length(); i <= s.length(); i++) {

            boolean same = true;

            for (int j = 0; j < 26; j++) {
                if (a[j] != b[j]) {
                    same = false;
                    break;
                }
            }

            if (same) {
                ans.add(i - p.length());
            }

            if (i < s.length()) {
                b[s.charAt(i) - 'a']++;
                b[s.charAt(i - p.length()) - 'a']--;
            }
        }

        return ans;
    }
}
Input:
s ="cbaebabacd"
p ="abc"
Output:
[0,6]
